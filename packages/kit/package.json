{
  "name": "@anybench/kit",
  "version": "0.0.0",
  "private": true,
  "description": "anybench.yaml loader/validator, ingest, drivers, proof checks, Harbor export",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anybench/core": "workspace:*",
    "@anybench/naive": "workspace:*",
    "@anybench/providers": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "bin": {
    "anybench-http-agent": "./dist/drivers/http-agent/bin.js"
  }
}
