{
  "name": "@anybench/runner",
  "version": "0.0.0",
  "private": true,
  "description": "in-VM runner (bun-compiled binary)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anybench-runner": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:bin": "node scripts/build-bin.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:docker": "RUNNER_DOCKER_E2E=1 vitest run test/docker-e2e.test.ts"
  },
  "dependencies": {
    "@anybench/core": "workspace:*",
    "@anybench/envs": "workspace:*",
    "zod": "^4.6.7"
  }
}
