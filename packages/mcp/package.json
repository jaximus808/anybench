{
  "name": "@anybench/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "Anybench MCP server (stdio): kit-authoring and run tools for your coding agent",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anybench-mcp": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anybench/core": "workspace:*",
    "@anybench/kit": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  }
}
