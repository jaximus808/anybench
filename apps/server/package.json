{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "description": "Hono API + worker + Drizzle schema + migrations",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "db:up": "docker compose -f ../../docker-compose.dev.yml up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anybench/core": "workspace:*",
    "@anybench/naive": "workspace:*",
    "@anybench/providers": "workspace:*",
    "@anybench/envs": "workspace:*",
    "@anybench/kit": "workspace:*",
    "@anybench/agents": "workspace:*",
    "@anybench/bench": "workspace:*",
    "@anybench/approver": "workspace:*",
    "@anybench/report": "workspace:*",
    "@anybench/publish": "workspace:*",
    "@anybench/billing": "workspace:*",
    "@anybench/alerts": "workspace:*",
    "@anybench/mcp": "workspace:*",
    "hono": "^4.13.17",
    "@hono/node-server": "^2.1.6",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "graphile-worker": "^0.18.0",
    "pino": "^10.4.0",
    "@sentry/node": "^11.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "@types/pg": "^8.23.1",
    "@anybench/outreach": "workspace:*"
  }
}
