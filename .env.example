# ─────────────────────────────────────────────────────────────────────────────
# Anybench secrets — EXAMPLE (committed; copy to .env and fill)
#
# Legend:  [YOU]  = you need to paste a value (where to get it is on the line above)
#          [GEN]  = already generated for you, leave as is
#          [SET]  = sensible default already filled, change only if you want
#
# When it's filled out, tell Claude. It will split this into:
#   apps/server/.env            (local API + worker)
#   apps/web/.env.local         (local Next.js; only NEXT_PUBLIC_* + server-side web vars)
#   Vercel project env          (prod web)
#   /etc/anybench.env on the Oracle worker VM (prod worker)
# and check each key works (Naïve credits.show, Stripe balance, R2 bucket, worker SSH, etc.).
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment & URLs ───────────────────────────────────────────────────────
NODE_ENV=development                                   # [SET]
ANYBENCH_ENV=local                                     # [SET] local | staging | prod
PUBLIC_WEB_URL=https://anybench.jaxonp.com           # [SET] prod web (Vercel)
PUBLIC_API_URL=https://api.anybench.jaxonp.com       # [SET] prod API (Vercel Functions)
SESSION_COOKIE_DOMAIN=.anybench.jaxonp.com             # [SET] shared session cookie across web + api (ignored for a localhost API outside production)
ALLOWED_ORIGINS=https://anybench.jaxonp.com,http://localhost:3000   # [SET] CORS + CSRF origin check
ANYBENCH_PAUSE=0                                       # [SET] global kill switch: 1 = no new trials, no new agent sessions
PORT=8787                                              # [SET] local API port (apps/server main.ts; ignored on Vercel)
LOG_LEVEL=info                                         # [SET] fatal | error | warn | info | debug | trace | silent
WORKER_ID=                                             # [SET] optional stable worker id; default <hostname>:<pid>
WORKER_CONCURRENCY=5                                   # [SET] graphile-worker jobs run in parallel per worker process
EVENTS_STREAM_MODE=poll                                # [SET] SSE /runs/:id/stream: poll (Vercel Functions) | listen (long-lived Node: one LISTEN on DATABASE_URL_DIRECT)
EVENTS_STREAM_MAX_DURATION_MS=50000                    # [SET] poll mode: end each SSE response after this long; clients reconnect with Last-Event-ID
EVENTS_POLL_INTERVAL_MS=1000                           # [SET] poll mode: how often an open stream re-reads the events table

# ── Web (apps/web, Next.js on Vercel) ───────────────────────────────────────
NEXT_PUBLIC_ANYBENCH_API_URL=http://localhost:8787     # [SET] API origin the browser calls (prod: https://api.anybench.jaxonp.com)
NEXT_PUBLIC_ANYBENCH_WEB_URL=http://localhost:3000     # [SET] this site's origin for metadata (prod: https://anybench.jaxonp.com)

# ── Naïve (ALL of our own agents + eval computers; $250 credit) ──────────────
# [YOU] usenaive.ai dashboard → API keys. Confirm the org plan is active (TDM-1).
NAIVE_API_KEY=
NAIVE_BASE_URL=https://api.vetta.sh                    # [SET]
NAIVE_CREDIT_BUDGET_MICRO_USD=250000000                # [SET] $250 — alerts at 70% / 90% spent; global kill switch below $25 left
NAIVE_LIVE=                                            # [SET] tests only: 1 runs the live Naïve smoke test (packages/naive); unset = offline fakes

# ── Agent under test (ONLY used inside trials, or documented fallback) ──────
# [YOU] console.anthropic.com → API keys. Used for our own demo/Tandem benchmark runs.
ANTHROPIC_API_KEY=
# [YOU] platform.openai.com → API keys. Model-swap contenders only.
OPENAI_API_KEY=

# ── Worker host: Oracle Cloud Always Free ARM VM (no Vultr) ────────────────
# [YOU] cloud.oracle.com → sign up (card for verification only) → Compute → Create instance:
#       shape VM.Standard.A1.Flex (Ampere, Always Free eligible: 2 OCPU / 12 GB), image Ubuntu 24.04 aarch64,
#       region us-ashburn-1 (closest to Neon us-east-1). Add your SSH public key. No inbound ports except 22.
WORKER_HOST_IP=
WORKER_SSH_USER=ubuntu
WORKER_SSH_PRIVATE_KEY_PATH=~/.ssh/anybench_worker

# ── Object storage: Cloudflare R2 (S3 API; 10 GB free, zero egress) ─────────
# [YOU] dash.cloudflare.com → R2 → create bucket "anybench-artifacts" → Manage R2 API tokens → create token
#       (Object Read & Write, this bucket) → copy Access Key ID, Secret Access Key and the account's S3 endpoint.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=anybench-artifacts
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Weekly encrypted Postgres dumps also go to this bucket under backups/.
# [YOU] run `brew install age && age-keygen -o ~/.config/anybench/backup.age` and paste the public key (age1...). Keep the private key OFF the server.
BACKUP_AGE_RECIPIENT=

# ── Database: Neon Postgres ($250 Neon credit) ──────────────────────────────
# [YOU] console.neon.tech → New project "anybench", region AWS us-east-1 (closest to Vercel iad1 and Oracle us-ashburn-1), Postgres 17.
#       Create a branch "dev" for local work. Connection details → copy BOTH strings for the dev branch here
#       (Claude puts the main-branch strings into prod env at deploy time):
# Pooled (host contains "-pooler"): API queries.
DATABASE_URL=
# Direct (no "-pooler"): migrations, graphile-worker, the LISTEN/NOTIFY event fanout.
DATABASE_URL_DIRECT=
# [YOU] console.neon.tech → Account settings → API keys. Lets CI create/delete a throwaway branch per e2e run.
NEON_API_KEY=
NEON_PROJECT_ID=
# Local offline tests only (docker compose postgres:16). Not used in prod.
# Host port 55432 (docker-compose.dev.yml), because 5432 is often taken by another local Postgres.
LOCAL_DATABASE_URL=postgres://anybench:anybench@localhost:55432/anybench
# Local docker postgres only.
POSTGRES_PASSWORD=anybench
# Optional: host port for docker-compose.dev.yml (default 55432). Change LOCAL_DATABASE_URL to match.
ANYBENCH_PG_PORT=
# Set to 1 (CI) to make the DB test suites fail instead of skip when LOCAL_DATABASE_URL is unreachable.
ANYBENCH_REQUIRE_DB=
# Tests only: file the docker-local base-recipe test (packages/envs) appends per-recipe timings to, as JSON lines.
ANYBENCH_RECIPES_LOG=

# ── App secrets (generated; rotate by regenerating) ─────────────────────────
SESSION_SECRET=   # generate: openssl rand -base64 48 (KEK: openssl rand -base64 32)
ANYBENCH_KEK=   # generate: openssl rand -base64 48 (KEK: openssl rand -base64 32)
ANYBENCH_KEK_PREVIOUS=                                                        # [SET] empty until the first rotation
RUNNER_TOKEN_SECRET=   # generate: openssl rand -base64 48 (KEK: openssl rand -base64 32)
METRICS_BEARER_TOKEN=   # generate: openssl rand -base64 48 (KEK: openssl rand -base64 32)

# ── GitHub OAuth (sign-in, scan, private repos) ─────────────────────────────
# [YOU] github.com/settings/developers → New OAuth App
#       Homepage:  https://anybench.jaxonp.com
#       Callback:  https://api.anybench.jaxonp.com/auth/github/callback
#       (make a second "Anybench (local)" app with callback http://localhost:8787/auth/github/callback for dev)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://api.anybench.jaxonp.com/auth/github/callback   # [SET] local: http://localhost:8787/auth/github/callback
# [YOU] optional: a fine-grained PAT (public repo read) to raise ingest rate limits for unauthenticated URL runs.
GITHUB_TOKEN=

# ── Admin & demo bypass ─────────────────────────────────────────────────────
ADMIN_GITHUB_LOGINS=jaximus808                          # [SET] comma list; only these can grant credits / comp runs. Every grant is logged in interventions.
BILLING_MODE=test                                      # [SET] off (local dev only, refuses to boot in prod) | test (Stripe test keys) | live
SIGNUP_GRANT_MICRO_USD=5000000                         # [SET] $5 credit grant on first sign-in (GitHub accounts older than 90 days)

# ── Usage limits (integer micro-USD) ────────────────────────────────────────
RUN_FEE_MICRO_USD=2000000                              # [SET] $2 per benchmark run (covers our Naïve agents: understand, research, kit, review, analyze)
COMPUTE_MARKUP_BPS=5000                                # [SET] eval computer time billed at Naïve cost + 50%, in 10-min blocks; infra failures never billed
COMPUTER_BLOCK_PRICE_MICRO_USD=27600                   # [SET] $0.0276 per 10-min eval-computer block (Naïve 2 vCPU / 4 GiB), for computer cost and leak alerts
MANAGED_TOKEN_MARKUP_BPS=2000                          # [SET] 20% over Naïve cost when users run on our tokens instead of their own key
USAGE_INVOICE_THRESHOLD_MICRO_USD=50000000             # [SET] bill early once unbilled usage reaches $50
NEW_ACCOUNT_SPEND_LIMIT_MICRO_USD=100000000            # [SET] max unbilled usage for an account with no paid invoice yet ($100)
USER_DAILY_SPEND_CAP_MICRO_USD=250000000               # [SET] hard daily cap per user ($250)
MAX_CONCURRENT_TRIALS_PER_USER=10                      # [SET]
RUNS_PER_DAY_PER_USER=20                               # [SET]
TRIAL_MAX_WALL_CLOCK_SEC=2700                          # [SET] 45 min hard stop per trial

# ── Stripe (usage-based billing: card on file → metered usage → monthly invoice; credit grants spend first) ─
# The app reads STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRICE_USAGE; Claude maps
# local + pre-launch prod → TEST values, prod after cutover → LIVE values.
# [YOU] dashboard.stripe.com → Developers → API keys (Test mode). A restricted key (rk_test_) is preferred.
STRIPE_TEST_SECRET_KEY=
# The key the server actually uses (copy of the TEST or LIVE key above, per BILLING_MODE). Boot refuses a prefix
# that does not match the mode: test → sk_test_/rk_test_, live → sk_live_/rk_live_.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
# [YOU] Developers → Webhooks → endpoint https://api.anybench.jaxonp.com/webhooks/stripe
#       events: checkout.session.completed, customer.subscription.created/updated/deleted,
#       invoice.finalized, invoice.paid, invoice.payment_failed, invoice.payment_action_required,
#       payment_method.attached, payment_method.detached, charge.refunded,
#       charge.dispute.created, charge.dispute.closed, radar.early_fraud_warning.created,
#       billing.credit_grant.created, billing.credit_grant.updated
#       (local: `stripe listen --forward-to localhost:8787/webhooks/stripe` prints a whsec_ for dev)
STRIPE_TEST_WEBHOOK_SECRET=
# [GEN-LATER] Claude creates these with the Stripe CLI once the test key is in (meter "anybench_usage", metered price, product):
STRIPE_TEST_METER_ID=
STRIPE_TEST_PRICE_USAGE=
# [YOU] LIVE keys: only after the Stripe account is activated (business details, bank, ToS/privacy/refunds URLs live).
STRIPE_LIVE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_METER_ID=
STRIPE_LIVE_PRICE_USAGE=

# ── Publish (verified, embeddable benchmarks) ───────────────────────────────
# [GEN] generate with node crypto.generateKeyPairSync("ed25519") (pkcs8/spki DER, base64). Ed25519 key that signs every published benchmark attestation. The public half is served at
#       https://api.anybench.jaxonp.com/.well-known/anybench-keys.json so anyone can verify a badge.
PUBLISH_SIGNING_KEY_ID=ab-2026-11
PUBLISH_SIGNING_PRIVATE_KEY_DER_B64=
PUBLISH_SIGNING_PUBLIC_KEY_DER_B64=
# [SET] rotated-out public keys that still verify old attestations: comma-separated key_id:spki_der_b64 pairs (empty until the first rotation)
PUBLISH_SIGNING_PREVIOUS_PUBLIC_KEYS=
PUBLIC_EMBED_URL=https://anybench.jaxonp.com/embed     # [SET] iframe widget base
PUBLIC_BADGE_URL=https://api.anybench.jaxonp.com/badge # [SET] SVG badge base (cached at the edge)

# ── Outreach / GTM (E15) ────────────────────────────────────────────────────
# [YOU] context.dev → API key (lead search: web-search, people-enrich). Primary lead source (E15 hackathon cut).
CONTEXT_DEV_API_KEY=
OUTREACH_CONTEXT_DEV_CREDIT_CAP=300                    # [SET] max Context.dev credits one sourcing run may spend
# [YOU] monid.ai → API key. Optional, X-only lead source; not needed for the hackathon cut.
MONID_API_KEY=
# [YOU] agentmail.to → API key (we have AgentMail credits).
# Optional: only if AgentMail is used directly. Default is AgentMail via Monid (docs/findings/monid-agentmail.md).
AGENTMAIL_API_KEY=
OUTREACH_FROM_ADDRESS=hello@mail.anybench.jaxonp.com   # [SET] AgentMail inbox on a sending subdomain (H7 adds its DNS)
# [YOU] Required by CAN-SPAM in every outreach email.
COMPANY_POSTAL_ADDRESS=
OUTREACH_DAILY_SEND_LIMIT=25                           # [SET] start low, raise as deliverability proves out
OUTREACH_PER_LEAD_BUDGET_MICRO_USD=500000              # [SET] $0.50 of Naïve agent spend to pre-build one lead's kit
OUTREACH_INVITE_GRANT_MICRO_USD=0                      # [SET] optional credit grant on an invite (0 = kit free, trials billed)
INVITE_TOKEN_SECRET=   # [GEN] generate: openssl rand -base64 48 · signs /i/<token> invite links

# ── Alerts ──────────────────────────────────────────────────────────────────
# [YOU] resend.com → API keys; verify domain anybench.jaxonp.com (adds DNS records).
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@anybench.jaxonp.com            # [SET]
ALERT_EMAIL_TO=jaxonp808@gmail.com                     # [SET] where ops alerts go
# [YOU] api.slack.com/apps → Incoming Webhooks → channel #anybench-alerts.
SLACK_WEBHOOK_URL=

# ── Platform observability (for us) ─────────────────────────────────────────
# [YOU] sentry.io → project "anybench-server" (Node) + "anybench-web" (Next.js) → DSNs.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# [YOU] optional: posthog.com project key for product analytics on the web app.
NEXT_PUBLIC_POSTHOG_KEY=
# [YOU] sentry.io → Settings → Auth tokens (source maps upload in CI).
SENTRY_AUTH_TOKEN=

# ── Deploy / CI ─────────────────────────────────────────────────────────────
# [YOU] vercel.com/account/tokens (CI deploys). ORG/PROJECT ids appear after `vercel link` in .vercel/project.json.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# [YOU] optional: only if jaxonp.com DNS is on Cloudflare and you want agents to create records.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── In-VM runner (packages/runner; dev and test only, never on an eval computer) ──
# Opt-in docker-local e2e of the compiled runner: pnpm --filter @anybench/runner test:docker
RUNNER_DOCKER_E2E=
# Image for that e2e (default debian:bookworm-slim: no Node, proves the binary is standalone).
RUNNER_DOCKER_IMAGE=
# Path to bun for `pnpm --filter @anybench/runner build:bin` (default: bun on PATH, else ~/.bun/bin/bun).
BUN=
